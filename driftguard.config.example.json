{
  "$schema": "./config.schema.json",
  "version": "2.0",
  "client": "frontend",
  "server": "backend",
  "serviceName": "PaymentGateway",
  "services": {
    "PaymentGateway": {
      "criticality": "TIER_0_CRITICAL",
      "isPublicApi": true,
      "environment": "production"
    }
  },
  "risk": {
    "baseWeightBreaking": 20,
    "baseWeightUnknown": 12,
    "publicApiBonus": 25,
    "transitiveBlastRadiusThreshold": 3,
    "transitiveBlastRadiusBonus": 25,
    "criticalityMultipliers": {
      "TIER_0_CRITICAL": 1.8,
      "TIER_1_HIGH": 1.3,
      "TIER_2_MEDIUM": 1,
      "TIER_3_LOW": 0.5
    },
    "thresholds": {
      "critical": 70,
      "high": 45,
      "medium": 20
    },
    "sensitiveFields": ["ssn", "passwordHash", "creditCard", "bankAccount"]
  }
}
